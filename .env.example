INSPECTOR_WEB_HOST=127.0.0.1
INSPECTOR_WEB_PORT=5000
INSPECTOR_RUNTIME_HOST=127.0.0.1
INSPECTOR_RUNTIME_PORT=8787
VITE_INSPECTOR_RUNTIME_URL=http://127.0.0.1:8787

# Set this path to persist local connection profile metadata across runtime restarts.
# Relative paths are resolved from apps/inspector-runtime.
# INSPECTOR_CONNECTIONS_PATH=.mcp-inspector/connections.json

# Set this path to persist local request history and replay records across runtime restarts.
# Relative paths are resolved from apps/inspector-runtime.
# INSPECTOR_HISTORY_PATH=.mcp-inspector/history.json

# The default theme is internal to the app. Set INSPECTOR_THEME to select a local custom theme.
# INSPECTOR_THEME=dracula-default

# Set this path to load local custom theme JSON files from another directory.
# Relative paths are resolved from apps/inspector-web.
# INSPECTOR_THEMES_PATH=.mcp-inspector/theme
